OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_NOTES_MODEL=gpt-5.6
OPENAI_LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
# Decimal MB. The current upstream API accepts at most 25 MB; no chunking yet.
MAX_UPLOAD_MB=25
OPENAI_TIMEOUT_SECONDS=180
